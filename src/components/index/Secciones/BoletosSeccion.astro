---

<section>
    <main>
        <div class="columna-izquierda">
            {
                data.map((boleto) => (
                    <Boletos
                        title={boleto.title}
                        description={boleto.description}
                        imgSrc={boleto.imgSrc}
                        imgAlt={boleto.imgAlt}
                        direccion={boleto.direccion}
                        day={boleto.day}
                        month={boleto.month}
                        year={boleto.year}
                    />
                ))
            }
        </div>
     
        <div class="columna-derecha">
            <form>
                <img src="/image/kaural/elkaurallogo2.png" alt="EL KAURAL" class="responsive-img">


                <div class="input-container">
                    <span class="icon">👤</span>
                    <input type="text" id="nombre" name="nombre" placeholder="Tu nombre">
                </div>

                <div class="input-container">
                    <span class="icon">✉️</span>
                    <input type="email" id="correo" name="correo" placeholder="Tu correo">
                </div>

                <input type="submit" value="Enviar" class="submit-btn">
            </form>
        </div>
    </main>
</section>

<style>
    section {
        display: flex;
        flex-direction: column;
        width: 100vw;
        height: auto;
        background-color: rgb(255, 255, 255);
        border-top: 1px solid black;
    }
    main {
        display: flex;
        flex-direction: row;
        width: 100%;
        height: auto;
    }
    .columna-izquierda {
        display: flex;
        flex-direction: column;
        flex: 0 auto;
        align-items: center;
        flex-grow: 1;
        flex-basis: 70%;
        border-right: 1px solid black;
        border-top: 1px solid black;
    }
    .columna-derecha {
        position: sticky;
        top: 25vh;
        flex: 0 auto;
        align-self: flex-start;
        display: flex;
        flex-direction: column;
        justify-content: center;
        height: 600px;
        width: 30%;

    }
    form {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        width: 100%;
        padding: 50px;
    }
    .title {
        font-size: clamp(24px, 7vw, 90px);
        font-weight: bold;
        color: rgb(0, 0, 0);
    }
    .responsive-img {
        max-width: 600px;
        max-height: 600px;
        width: 100%;
        height: auto;
    }
    /* Estilo para los inputs */
    .input-container {
        display: flex;
        align-items: center;
        width: 100%;
        margin-bottom: 20px; /* Separación entre inputs */
        border: 2px solid black;
        padding: 10px;
        border-radius: 5px;
        background-color: white;
    }

    .icon {
        margin-right: 10px;
        font-size: 1.5rem;
    }

    input[type="text"],
    input[type="email"] {
        flex-grow: 1;
        border: none;
        outline: none;
        font-size: 1rem;
        padding: 5px;
        background-color: rgb(255, 255, 255);
        width: 100%;
        box-sizing: border-box; 
    }

    /* Estilo para el botón */
    .submit-btn {
        width: 100%;
        padding: 10px;
        background-color: black;
        color: white;
        font-size: 1.2rem;
        font-weight: bold;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

    .submit-btn:hover {
        background-color: rgb(50, 50, 50);
    }

    .submit-btn:active {
        background-color: rgb(20, 20, 20);
    }

    .submit-btn:focus {
        outline: none;
    }
    @media (max-width: 768px) {
        main {
            flex-direction: column-reverse;
        }
        .columna-izquierda {
            border-right: none;
        }
        .columna-derecha {
            position: static;
            width: 100%;
            padding: 24px;
        }
    }
</style>